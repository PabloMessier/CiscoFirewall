# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude tfvars JSON files (terraform.tfvars is committed as a template)
*.tfvars.json

# Ignore override files as they are usually used for local development
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock files
.terraform.lock.hcl

# Sensitive or local files
.env
credentials.json
*.pem

# macOS
.DS_Store

# Stress test logs
scripts/stress_test_*.log

# Packer
packer/.packer.d/
